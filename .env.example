# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Cloud Run API URL (for Next.js to call)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side URL used by the protected Next.js order-list proxy
API_BASE_URL=http://localhost:8080

# Generate a random server-to-server token of at least 32 characters.
ORDER_LIST_IMPORT_API_TOKEN=
# Optional comma-separated additions to the two built-in workbook image hosts.
ORDER_LIST_IMAGE_HOST_ALLOWLIST=


# GCP
GCP_PROJECT_ID=spectre-tomstocks-20260227
STORE_NAME=manman
ORDER_LIST_SYNC_JOB_NAME=haraka-manman-sync
GENERATE_JOB_NAME=haraka-manman-generate

# Google OAuth (Haraka DB シート用)
HARAKA_DB_SPREADSHEET_ID=
POKEMON_BOX_SPREADSHEET_ID=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 画像生成後の買取価格一覧反映先
BUYBACK_SPREADSHEET_ID=

# KECAK シート用 OAuth（KECAK シートにアクセス権限のあるアカウントの refresh token）
# 未設定の場合は上記のデフォルト認証情報にフォールバック
KECAK_GOOGLE_REFRESH_TOKEN=

# Google OAuth (Web UI / オーダーリスト運用者ログインで共用)
# Google Consoleには NEXTAUTH_URL/api/auth/google/callback をredirect URIとして登録します。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 本番ではパスなしのHTTPS originを指定します（例: https://harakafor-manman-web.vercel.app）。
NEXTAUTH_URL=http://localhost:3000
# Googleでログインを許可する運用者メール。複数はカンマ区切りです。
ORDER_LIST_OPERATOR_EMAILS=
# Set false to allow public access to /runs and operator API proxies.
OPERATOR_AUTH_REQUIRED=true

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord Webhook (optional, for job notifications)
DISCORD_WEBHOOK_URL=
