# Preserve the running Tokyo API and replace only its shared Peleka catalog module.
FROM asia-northeast1-docker.pkg.dev/spectre-tomstocks-20260227/haraka/haraka-manman-api@sha256:e53436a8534bc9ac0f43a08584904d85c70b30779b8bac712c04446c22e40d5d AS baseline
RUN node -e "const fs=require('node:fs'),a=require('node:assert/strict'),c=require('node:crypto'); const t=fs.readFileSync('/app/packages/job/dist/lib/peleka-catalog.js','utf8').replace(/\r\n/g,'\n').replace(/\n?\/\/# sourceMappingURL=.*\s*$/,'').trimEnd(); a.equal(c.createHash('sha256').update(t).digest('hex'),'5d4ec3505532d540fa2a1174f84a516836a1cf624606a930a20e6df035c316c2'); console.log('TOKYO_API_BASELINE_MATCH');"

FROM baseline AS builder
WORKDIR /app
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY packages/job/ packages/job/
RUN npm -w packages/shared run build && npm -w packages/job run build

FROM baseline
COPY --from=builder /app/packages/job/dist/lib/peleka-catalog.* /app/packages/job/dist/lib/
COPY packages/job/src/lib/peleka-catalog.ts /app/packages/job/src/lib/peleka-catalog.ts
RUN node -e "const a=require('node:assert/strict'); const m=require('/app/packages/job/dist/lib/peleka-catalog.js'); const p=m.buildTokyoPelekaCatalog({runId:'run',snapshotId:'snapshot',businessDate:'2026-11-15',generatedAt:'2026-11-15T00:00:00Z',cards:[{id:'card',source_shinsoku_id:'kecak-only',card_name:'Gogeta',franchise:'DRAGON BALL',grade:'PSA10',list_no:'FB09-121',image_url:'https://example.test/gogeta.png',price_high:230000,price_low:230000}],pricingSources:new Map([['kecak-only',[{source:'kecak',rawPrice:249900,baselineHighRate:0.05,baselineHighPrice:230000,baselineLowRate:0.05,baselineLowPrice:230000}]]])}); a.equal(p.count,1); a.equal(p.products[0].priceHigh,230000); a.equal(p.products[0].pricingSources[0].rawPrice,249900); a.equal(p.products[0].shinsokuPrice,undefined); console.log('TOKYO_API_KECAK_CATALOG_PASS');"
